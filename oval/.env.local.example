# OVAL Dashboard (Next.js) — Environment Variables
# Copy to oval/.env.local and fill in real values.

# Supabase (required — dashboard won't load without these)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=eyJ...

# Supabase service key (for API routes that need admin access)
SUPABASE_SERVICE_KEY=eyJ...

# Google (for SEO/News pages)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# OpenAI (for AI-powered features in dashboard)
OPENAI_API_KEY=sk-proj-...

# Restricted preview mode: only /playstore reachable, login required
PLAYSTORE_ONLY=false
ACCESS_PASSWORD=change-me

# Slack delivery for Play Store briefing
SLACK_BOT_TOKEN=xoxb-...
PLAYSTORE_SLACK_CHANNEL_ID=D0123456789
PLAYSTORE_SLACK_USER_ID=U0123456789
PLAYSTORE_SLACK_CHANNEL_IDS=D0123456789,D0987654321
PLAYSTORE_SLACK_USER_IDS=U0123456789,U0987654321
PLAYSTORE_SLACK_TRIGGER_TOKEN=change-me-internal-trigger
