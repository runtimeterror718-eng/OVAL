# OVAL Dashboard (Next.js) — Environment Variables
# Copy to oval/.env.local and fill in real values.

# Supabase (required — dashboard won't load without these)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=

# Supabase service key (for API routes that need admin access)
SUPABASE_SERVICE_KEY=

# Google (for SEO/News pages)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# OpenAI (for AI-powered features in dashboard)
OPENAI_API_KEY=

# Restricted preview mode: approved pages require Supabase @pw.live OTP login
PLAYSTORE_ONLY=false

# Issue CRM (server-only)
CRM_BOOTSTRAP_ADMIN_EMAILS=admin@pw.live
CRM_REMINDER_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Development-only. The code also requires a loopback request on port 3001.
CRM_DEV_AUTH_BYPASS=false
INTEGRATIONS_DEV_AUTH_BYPASS=false

# Slack delivery for Play Store briefing
SLACK_BOT_TOKEN=
PLAYSTORE_SLACK_CHANNEL_ID=D0123456789
PLAYSTORE_SLACK_USER_ID=U0123456789
PLAYSTORE_SLACK_CHANNEL_IDS=D0123456789,D0987654321
PLAYSTORE_SLACK_USER_IDS=U0123456789,U0987654321
PLAYSTORE_SLACK_TRIGGER_TOKEN=
# Server-only Qdrant RAG retrieval (never use NEXT_PUBLIC_)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=oval_channel_mentions_v1

# Official social OAuth integrations (all values are server-only)
OVAL_PUBLIC_URL=http://localhost:3001
# Generate both secrets independently with: openssl rand -base64 32
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_OAUTH_STATE_SECRET=
SOCIAL_SYNC_TRIGGER_TOKEN=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_SCOPES=r_organization_social r_organization_social_feed rw_organization_admin
LINKEDIN_API_VERSION=202607

X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_SCOPES=tweet.read users.read offline.access

META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_OAUTH_SCOPES=pages_show_list pages_read_engagement pages_read_user_content

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic instagram_business_manage_comments

# Sentiment Vault (server-only)
VAULT_ENABLED=true
VAULT_BRAND_ID=166d8523-79a0-4b1c-b56f-8b40b6cc2f1f
# Generate with: openssl rand -hex 32
VAULT_SNAPSHOT_TRIGGER_TOKEN=
